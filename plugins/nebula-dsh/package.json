{
  "name": "dsh-nebula-mcp",
  "version": "0.1.11",
  "private": true,
  "type": "module",
  "description": "Read-only YueShu graph database (NebulaGraph 5.x) integration for DeepSeek Harness.",
  "engines": {
    "dsh": "^0.2.2-rc.5"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "runtime.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "icon.svg",
    "probe.py"
  ],
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
